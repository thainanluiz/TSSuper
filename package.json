{
  "name": "@thainanluiz/tssuper",
  "version": "0.0.11",
  "description": "Simple add-on for TypeScript",
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "jest",
    "typecheck": "tsc -p src/tsconfig.json && tsc -p tsconfig.json",
    "check:package": "npm run build && publint && attw --pack .",
    "prepublishOnly": "npm run typecheck && npm test && npm run check:package"
  },
  "keywords": [
    "jssuper",
    "tssuper",
    "javascript",
    "typescript",
    "addon",
    "library"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thainanluiz/TSSuper.git"
  },
  "bugs": {
    "url": "https://github.com/thainanluiz/TSSuper/issues"
  },
  "homepage": "https://github.com/thainanluiz/TSSuper#readme",
  "author": "Thainan Luiz",
  "license": "MIT",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0",
    "publint": "^0.3.25",
    "ts-jest": "^29.1.4",
    "tsup": "^8.1.0",
    "typescript": "^5.4.5"
  }
}
