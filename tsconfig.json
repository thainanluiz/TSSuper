{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "paths": {
      "@thainanluiz/tssuper": ["./src/index.ts"]
    }
  },
  "include": ["src", "tests", "examples"],
  "exclude": ["src/globals.d.ts"]
}
